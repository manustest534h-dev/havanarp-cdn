<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/content_description_back"
            android:gravity="center"
            android:text="@string/symbol_back"
            android:textColor="@color/ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/editorHeading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/editor_new"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/delete"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_label"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical|start"
                android:hint="@string/title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="#98A2B3"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/details_label"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/bodyInput"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="@string/details_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp"
                android:scrollbars="vertical"
                android:textColor="@color/ink"
                android:textColorHint="#98A2B3"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/category_label"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/color_label"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/colorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/colorAmber"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#F6A03D"
                    android:checked="true"
                    android:text="@string/color_sun" />

                <RadioButton
                    android:id="@+id/colorGreen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#1B7F79"
                    android:text="@string/color_mint" />

                <RadioButton
                    android:id="@+id/colorBlue"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#5577C6"
                    android:text="@string/color_sky" />

                <RadioButton
                    android:id="@+id/colorRose"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:buttonTint="#C85A7C"
                    android:text="@string/color_rose" />
            </RadioGroup>

            <Switch
                android:id="@+id/pinnedSwitch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/pin_note"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_primary"
        android:elevation="3dp"
        android:gravity="center"
        android:text="@string/save_note"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
